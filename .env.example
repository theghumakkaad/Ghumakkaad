# Copy this file to .env.local and fill it in.
# Both of these are safe in the browser: row level security means this key
# can only READ active packages, and can only write when someone is signed in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted instead, and is the name
# the Vercel Supabase integration writes for you. Either one is read, so a
# Vercel-connected project needs nothing renamed.

# Leave Supabase blank and the site runs on the content in
# lib/trips.js instead, which is useful offline. The build log says so
# clearly when that happens, rather than failing quietly.

# Google Analytics 4. Leave blank and nothing loads: no script, no
# request, no cookie. Get a Measurement ID (looks like G-XXXXXXXXXX)
# from analytics.google.com -> Admin -> Data Streams -> your site.
NEXT_PUBLIC_GA_ID=

# Google Search Console ownership. Get this from Search Console ->
# Settings -> Ownership verification -> HTML tag method -> copy just
# the "content" value out of the meta tag it shows you (not the whole
# tag). Leave blank and no verification meta tag is printed.
NEXT_PUBLIC_GSC_VERIFICATION=
